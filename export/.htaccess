<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect old contact numbers in blog URLs to the current number.
    RewriteCond %{REQUEST_URI} !0594006091
    RewriteRule ^blog/((?:.*-)?)(?:(?:\+?966|0)?5[0-9]{8}|\+?201[0-9]{9})(-.*)?$ /blog/$10594006091$2 [R=301,L,NE]
</IfModule>
